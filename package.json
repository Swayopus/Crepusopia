{
  "name": "crepusopia",
  "type": "module",
  "version": "0.2.2",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "check": "node scripts/astro.mjs check && tsc -p tsconfig.scripts.json",
    "test": "node --test tests/core.test.ts tests/resource-delivery.test.mjs tests/font-loading.test.ts tests/tag-navigation.test.mjs tests/hitokoto.test.mjs",
    "build": "node scripts/astro.mjs build && pagefind --site dist",
    "preview": "node scripts/astro.mjs preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:build": "node scripts/check-build.mjs",
    "check:subpath": "node scripts/check-subpath.mjs",
    "fonts:generate": "python scripts/fonts/subset.py",
    "fonts:check": "python scripts/fonts/subset.py --check",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run check:build",
    "new-post": "node scripts/new-post.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "katex": "0.16.47",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-math": "6.0.0",
    "remark-obsidian-callout": "1.5.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "cheerio": "1.2.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "shiki": "4.5.0",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "description": "A personal Astro blog with Markdown, MDX, local search, and light/dark themes.",
  "license": "MIT"
}
