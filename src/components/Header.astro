---
import { withBase } from "@utils/url";
// @component Header — 网站头部组件，包含头像、站点标题和打字机字幕
import { siteConfig } from "@/config";
import TypewriterText from "@components/TypewriterText.astro";

// 首页检测用于打字机；页面主标题由 main 内的 h1 提供。
const isHome = Astro.url.pathname === import.meta.env.BASE_URL;
---

<header class="mb-6 lg:mb-8 h-[11rem] lg:h-[13.5rem]">
  {/* 头像 — 链接到首页，仅当配置了头像时显示 */}
  {siteConfig.avatar && <a href={withBase("/")} class="block mb-4 lg:mb-5">
    <img
      data-site-avatar
      src={withBase(siteConfig.avatar)}
      alt={siteConfig.title}
      class="w-16 h-16 lg:w-20 lg:h-20 rounded-full object-cover
                  ring-2 ring-[var(--color-border)] hover:ring-[var(--color-primary)]/50
                  transition-all duration-300"
      width="80"
      height="80"
    />
  </a>}

  <div class="mb-3">
    {/* 标题在首页/内页相同；显式标注 family-name，避免被当作 font-weight。 */}
    {/* 手机抽屉仅有 11rem 内容宽度；展示字体按原品牌字宽校准，桌面保持原字号。 */}
    <div
      class="mb-[1.25rem] font-black font-(family-name:--font-title) text-[1.875rem] lg:text-[2.25rem] leading-[1.4] text-[var(--color-primary)]"
    >
      <a
        href={withBase("/")}
        class="inline-block text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors"
        transition:name="site-title"
      >
        {siteConfig.title}
      </a>
    </div>
  </div>

  {/* 副标题区域：首页显示打字机动画；子页面显示静态双语格言 */}
  <div
    class="text-base text-[var(--color-text-muted)] font-(family-name:--font-nav) leading-relaxed h-[2.5rem] lg:text-lg lg:h-[3.2rem]"
  >
    {isHome ? (
      <TypewriterText
        lines={siteConfig.banner.subtitles}
        typingSpeed={40}
        deletingSpeed={20}
        pauseDuration={5000}
        once={true}
      />
    ) : (
      siteConfig.banner.subtitles.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))
    )}
  </div>
</header>
