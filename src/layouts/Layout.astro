---
import Icon from "@components/Icon.astro";
import { withBase } from "@utils/url";
// @layout Layout — 页面根 HTML 骨架
// 布局结构（桌面端 3 列 CSS Grid）：
//   左侧栏：Header（头像+标题）+ Navbar（导航）+ Footer（社交/搜索/主题）
//   中间主内容区：<slot /> —— 由各页面模板填充
//   右侧栏（可选）：<slot name="widgets" /> —— 用于文章目录等组件
// 手机和平板：侧边栏改为滑出抽屉，顶栏固定吸附；宽屏鼠标设备使用桌面布局。
// 数据来源：siteConfig
import { siteConfig } from "@/config";
import { ClientRouter } from "astro:transitions";
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import SearchModal from "@components/SearchModal.astro";
import "@styles/font.css";
import "@styles/theme.css";

interface Props {
  /** 页面标题 */
  title?: string;
  /** 页面描述（用于 SEO） */
  description?: string;
  /** Open Graph 图片路径 */
  ogImage?: string;
  /** 文章分享元数据；普通页面沿用 website。 */
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** 是否显示右侧组件栏（如文章目录） */
  rightWidgets?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogType,
  publishedTime,
  modifiedTime,
  rightWidgets = false,
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <Head
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <ClientRouter fallback="none" />
  </head>
  <body>
    <!-- 移动端顶栏 — 桌面端隐藏 -->
    <div class="mobile-topbar lg:hidden">
      <a
        href={withBase("/")}
        class="font-black font-(family-name:--font-title) text-lg text-[var(--color-primary)] no-underline truncate"
      >
        {siteConfig.title}
      </a>
      <button
        id="menu-toggle"
        class="menu-toggle-btn"
        aria-label="Toggle menu"
        aria-controls="sidebar"
        aria-expanded="false"
      >
        <Icon name="hamburger" size={22} />
      </button>
    </div>

    <!-- 移动端侧边栏遮罩层 — 桌面端隐藏 -->
    <div id="sidebar-overlay" class="sidebar-overlay lg:hidden"></div>

    <!--
      三列 CSS Grid 主容器
      - 移动端：单列流式布局
      - 桌面端 (lg)：3 列网格
        grid-cols-[18rem_minmax(0,1fr)_16rem]
        列1 左侧栏：18rem 固定宽
        列2 主内容：弹性伸缩 minmax(0,1fr)
        列3 右侧栏：16rem 固定宽（可选）
      - translate-x-[6rem]：整体向右偏移，使左侧栏更靠近屏幕中央
    -->
    <div
      class="site-layout mx-auto w-full px-[min(7.25vw,3.731rem)] py-10
             lg:grid lg:gap-x-6 lg:px-8 lg:py-20 lg:max-w-[87rem]
             lg:grid-cols-[18rem_minmax(0,1fr)_16rem] lg:translate-x-[6rem]"
    >
      <!--
        左侧栏：Header + Navbar 在上，mt-auto 将 Footer 推向底部。
        视口高度除以整页缩放比例，避免固定基准高度让底部信息挤在导航下方。
        手动放大至内容超出视口时允许侧栏滚动，确保底部入口仍能访问。
      -->
      <aside
        id="sidebar"
        class="lg:sticky lg:top-20 lg:self-start lg:flex lg:flex-col lg:min-h-[calc(100vh/var(--page-scale,1)-13rem)] lg:max-h-[calc(100vh/var(--page-scale,1)-5rem)] lg:mr-2"
      >
        <div>
          <Header />
          <Navbar />
        </div>
        <div class="mt-auto">
          <Footer />
        </div>
      </aside>

      <!-- 中间主内容区：min-w-0 防止内容溢出撑破网格 -->
      <main class="min-w-0">
        <slot />
      </main>

      <!-- 右侧栏（可选）：仅在 rightWidgets 为 true 时渲染 -->
      {rightWidgets && <aside class="hidden lg:block">
        <slot name="widgets" />
      </aside>}
    </div>
    {siteConfig.features.search && <SearchModal />}
    <slot name="overlays" />
  </body>
</html>

<style is:global>
  /* 与 theme.css 的 lg 条件互补，覆盖宽屏触屏平板和小数视口宽度。 */
  @media not all and (min-width: 1800px) and (hover: hover) and (pointer: fine) {
    body {
      /* 内容层与底色层共用参数，防止后续调整宽度、动效时不同步。 */
      --drawer-width: min(14rem, 80vw);
      --drawer-duration: 0.3s;
      --drawer-easing: cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      min-height: 100dvh;
    }

    /*
     * 抽屉打开后，在文档绘制层补上同色背景。
     * 已测的小数 DPR 截图中，底色层能降低视口最后一行与抽屉内部的色差；
     * 加高抽屉、负 bottom 和外扩阴影未改善该样例。具体裁剪/合成原因尚未由浏览器跟踪确认。
     * 此层按 body 高度铺设；已测长、短页面未增加滚动高度，无需额外设置 overflow: clip。
     * 它不占正常布局空间、不拦截点击，与抽屉同步滑动，收回后隐藏。
     */
    body::before {
      content: "";
      position: absolute;
      inset: 0;
      left: 0;
      width: var(--drawer-width);
      z-index: 99;
      background: var(--color-bg);
      pointer-events: none;
      visibility: hidden;
      /* 用 transform 移动以减少布局更新；是否重绘或提升合成层由浏览器决定。 */
      transform: translateX(calc(-1 * var(--drawer-width)));
      transition:
        transform var(--drawer-duration) var(--drawer-easing),
        visibility 0s var(--drawer-duration);
    }
    body:has(#sidebar.open)::before {
      transform: translateX(0);
      visibility: visible;
      /* 打开时立即参与绘制，关闭时等滑出结束后再隐藏。 */
      transition-delay: 0s;
    }

    .mobile-topbar {
      position: sticky;
      top: 0;
      z-index: 90;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.7rem max(1rem, env(safe-area-inset-right)) 0.7rem
        max(1rem, env(safe-area-inset-left));
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
    }

    .menu-toggle-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--color-text);
      cursor: pointer;
      flex-shrink: 0;
    }
    .menu-toggle-btn:active {
      background: var(--color-bg-alt);
    }

    /* 汉堡菜单 → X 动画 */
    .menu-toggle-btn .menu-line {
      transition:
        transform 0.3s ease,
        opacity 0.2s ease;
      transform-origin: center;
    }
    .menu-open .menu-line-top {
      transform: translateY(6px) rotate(45deg);
    }
    .menu-open .menu-line-mid {
      opacity: 0;
    }
    .menu-open .menu-line-bot {
      transform: translateY(-6px) rotate(-45deg);
    }

    /* 侧边栏抽屉 */
    #sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: var(--drawer-width);
      z-index: 100;
      background: var(--color-bg);
      transform: translateX(-100%);
      transition: transform var(--drawer-duration) var(--drawer-easing);
      overflow-y: auto;
      overscroll-behavior-y: contain;
      padding: 5rem 1.5rem 1.5rem; /* 顶部留出额外空间，将 header/nav 向下推 */
      /* 手势导航安全区留在抽屉内部，不在底部制造外部缝隙。 */
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
      display: flex;
      flex-direction: column;
    }
    #sidebar.open {
      transform: translateX(0);
      box-shadow: 2px 0 24px rgba(0, 0, 0, 0.15);
    }

    /* 遮罩层 */
    .sidebar-overlay {
      position: fixed;
      inset: 0;
      z-index: 98;
      background: rgba(0, 0, 0, 0.4);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--drawer-duration) ease;
      touch-action: none;
    }
    .sidebar-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  import { lockDrawerScroll } from "@/scripts/drawer-scroll";
  import { onPageLoad } from "@/scripts/lifecycle";

  const desktopLayout = matchMedia("(min-width: 1800px) and (hover: hover) and (pointer: fine)");
  let drawerScrollLock: AbortController | undefined;
  /** 关闭的手机/平板抽屉不能进入键盘焦点，桌面侧栏始终可访问。 */
  function syncSidebarAccessibility() {
    const sidebar = document.getElementById("sidebar");
    if (!sidebar) return;
    const hidden = !desktopLayout.matches && !sidebar.classList.contains("open");
    sidebar.inert = hidden;
    if (hidden) sidebar.setAttribute("aria-hidden", "true");
    else sidebar.removeAttribute("aria-hidden");
  }

  /** 切换侧边栏开/关状态 */
  function toggleSidebar() {
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const toggle = document.getElementById("menu-toggle");
    if (!sidebar || !overlay || !toggle) return;
    const open = sidebar.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(open));
    overlay.classList.toggle("open", open);
    toggle.classList.toggle("menu-open", open);
    syncSidebarAccessibility();
    // 保持根滚动容器不变；关闭或快速反向时先释放上一轮输入锁。
    drawerScrollLock?.abort();
    drawerScrollLock = open && !desktopLayout.matches ? lockDrawerScroll(sidebar) : undefined;
  }

  /** 关闭侧边栏 */
  function closeSidebar() {
    drawerScrollLock?.abort();
    drawerScrollLock = undefined;
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const toggle = document.getElementById("menu-toggle");
    if (!sidebar || !overlay || !toggle) return;
    sidebar.classList.remove("open");
    toggle.setAttribute("aria-expanded", "false");
    overlay.classList.remove("open");
    toggle.classList.remove("menu-open");
    syncSidebarAccessibility();
  }

  document.addEventListener("click", (e) => {
    const target = e.target;
    if (!(target instanceof Element)) return;
    // 点击汉堡按钮 → 切换侧边栏
    if (target.closest("#menu-toggle")) {
      toggleSidebar();
      return;
    }
    // 点击遮罩层 → 关闭侧边栏
    if (target.closest("#sidebar-overlay")) {
      closeSidebar();
      return;
    }
    // 点击侧边栏内的任意链接或按钮 → 关闭侧边栏（导航、社交图标、搜索、主题等）
    if (target.closest("#sidebar a, #sidebar button")) {
      closeSidebar();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeSidebar();
  });

  // 页面切换后自动关闭侧边栏
  document.addEventListener("astro:before-swap", () => {
    // 不让旧页面的滚动保护干扰 Astro 在新页面恢复阅读位置。
    drawerScrollLock?.abort();
    drawerScrollLock = undefined;
  });
  document.addEventListener("astro:after-swap", () => {
    closeSidebar();
  });
  document.addEventListener("astro:page-load", () => {
    closeSidebar();
  });
  desktopLayout.addEventListener("change", closeSidebar);
  closeSidebar();

  // 只在内容确实超高时开启内部滚动，正常高度不裁剪头像轮廓和悬停效果。
  onPageLoad((signal) => {
    const sidebar = document.getElementById("sidebar");
    if (!sidebar) return;
    const syncOverflow = () => {
      // srcset 按实际显示宽度选图，涵盖整页 zoom、窗口变化和原生浏览器缩放。
      const avatar = sidebar.querySelector<HTMLImageElement>("img[data-site-avatar][srcset]");
      if (avatar) {
        const sizes = `${Math.ceil(avatar.getBoundingClientRect().width)}px`;
        if (avatar.sizes !== sizes) avatar.sizes = sizes;
      }
      sidebar.classList.toggle(
        "lg:overflow-y-auto",
        desktopLayout.matches && sidebar.scrollHeight > sidebar.clientHeight + 1,
      );
    };
    const observer = new ResizeObserver(syncOverflow);
    observer.observe(sidebar);
    // 字体加载或底部文字换行时，子块可能变高而侧栏仍受 max-height 限制。
    for (const child of sidebar.children) observer.observe(child);
    desktopLayout.addEventListener("change", syncOverflow, { signal });
    window.addEventListener("resize", syncOverflow, { signal });
    syncOverflow();
    return () => observer.disconnect();
  });
</script>
